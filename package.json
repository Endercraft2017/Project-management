{
  "name": "servicebay-pm",
  "version": "1.0.0",
  "description": "E-Z project management and team collaboration SaaS",
  "private": true,
  "workspaces": [
    "server",
    "client",
    "shared"
  ],
  "scripts": {
    "start": "npm run start --workspace=server",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run prisma:generate && npm run build --workspaces",
    "build:server": "npm run build --workspace=server",
    "build:client": "npm run build --workspace=client",
    "prisma:generate": "cd server && npx prisma generate",
    "test": "npm run test --workspaces",
    "test:server": "npm run test --workspace=server",
    "test:client": "npm run test --workspace=client",
    "lint": "npm run lint --workspaces",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "typecheck": "npm run typecheck --workspaces",
    "prepare": "husky install"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "prettier": "^3.2.5",
    "sass-embedded": "^1.93.2"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-tooltip": "^1.2.8"
  },
  "overrides": {
    "body-parser": "1.20.9",
    "proxy-addr": "2.0.8",
    "qs": "6.16.2",
    "follow-redirects": "1.16.2",
    "handlebars": "4.7.10",
    "shell-quote": "1.12.0",
    "source-map-js": "1.2.2",
    "postcss-selector-parser": "6.1.5",
    "vite": {
      "esbuild": "0.28.2"
    }
  },
  "packageManager": "npm@11.9.0"
}
