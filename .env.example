# Node Environment
NODE_ENV=production
PORT=5000

# Database Connection
# Railway auto-configures this when you add PostgreSQL
# For local development, use: postgresql://user:password@localhost:5432/dbname
DATABASE_URL=postgresql://user:password@localhost:5432/servicebay_pm

# Session Secret
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your_32_character_random_secret_here

# Google OAuth Credentials
# Get from: Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=123456789-abc.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<your-google-client-secret>
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Admin Configuration
# Comma-separated list of admin email addresses
ADMIN_EMAILS=admin@servicebay.ai,manager@servicebay.ai
ALLOWED_EMAIL_DOMAIN=@servicebay.ai

# Frontend/CORS Configuration
CLIENT_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Production URLs (for Railway)
# Replace with your Railway app URL:
# GOOGLE_CALLBACK_URL=https://your-app-name.up.railway.app/api/auth/google/callback
# CLIENT_URL=https://your-app-name.up.railway.app
# CORS_ORIGIN=https://your-app-name.up.railway.app

# ============================================
# OPTIONAL: Google Sheets Integration
# ============================================
# Only add these if you want bi-directional sync with Google Sheets
# Otherwise, use CSV/Excel import/export instead

# Google Sheets API Configuration
# Get from: Service Account JSON file -> client_email
# GOOGLE_SERVICE_ACCOUNT_EMAIL=servicebay-pm-sheets@project-id.iam.gserviceaccount.com
# Get from: Service Account JSON file -> private_key
# IMPORTANT: Keep the quotes and \n characters
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYourPrivateKeyContentHere\n-----END PRIVATE KEY-----\n"
