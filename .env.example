# Node Environment
NODE_ENV=production
PORT=5000

# Database Connection
# Railway auto-configures this when you add PostgreSQL
# For local development, use: postgresql://user:password@localhost:5432/dbname
DATABASE_URL=postgresql://user:password@localhost:5432/servicebay_pm

# Session Secret
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your_32_character_random_secret_here

# Google OAuth Credentials
# Get from: Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=123456789-abc.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<your-google-client-secret>
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Admin Configuration
# Comma-separated list of admin email addresses
ADMIN_EMAILS=admin@servicebay.ai,manager@servicebay.ai
ALLOWED_EMAIL_DOMAIN=@servicebay.ai

# Frontend/CORS Configuration
CLIENT_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Base URL used in email links
APP_URL=http://localhost:5173

# Production URLs (for Railway)
# Replace with your Railway app URL:
# GOOGLE_CALLBACK_URL=https://your-app-name.up.railway.app/api/auth/google/callback
# CLIENT_URL=https://your-app-name.up.railway.app
# CORS_ORIGIN=https://your-app-name.up.railway.app
# APP_URL=https://your-app-name.up.railway.app

# ============================================
# RECOMMENDED for production
# ============================================

# REQUIRED when NODE_ENV=production: the server refuses to start without it.
# Encrypts Google OAuth tokens stored in the database (AES-256-GCM).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Existing plaintext tokens keep working and are encrypted on next sign-in.
# Don't lose or change it once set: stored tokens can't be read without it
# (users would just need to sign in again).
TOKEN_ENCRYPTION_KEY=

# Where uploaded files are stored. Railway's disk is wiped on every deploy,
# so attach a Railway Volume and point this at it (e.g. /data/uploads).
# Relative paths are resolved from the server folder.
# UPLOAD_DIR=uploads

# Requests allowed per user per 15-minute window (default 1000)
# RATE_LIMIT_MAX_REQUESTS=1000

# Timezone for scheduled reminders and weekly summaries
# TZ=America/New_York

# ============================================
# OPTIONAL: feature-specific
# ============================================

# Weekly AI summaries
# OPENAI_API_KEY=

# Email (invites, reminders, weekly summaries)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="ServiceBay PM <noreply@example.com>"

# Google Drive file picker and viewing publicly shared Drive files
# GOOGLE_API_KEY=

# Google Sheets bi-directional sync (otherwise use CSV/Excel import)
# Get from: Service Account JSON file -> client_email
# GOOGLE_SERVICE_ACCOUNT_EMAIL=servicebay-pm-sheets@project-id.iam.gserviceaccount.com
# Get from: Service Account JSON file -> private_key
# IMPORTANT: Keep the quotes and \n characters
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYourPrivateKeyContentHere\n-----END PRIVATE KEY-----\n"
