# Configuration reference. Backend npm scripts read server/.env, not this root file.
# Local quick start: node scripts/setup-local-env.mjs (fresh secrets, no provider account).
# Production: inject real values securely; never copy local development secrets.
NODE_ENV=development
PORT=3000
# Placeholder only; create your own PostgreSQL user/password/database.
DATABASE_URL=postgresql://ez_local:replace_with_local_db_password@127.0.0.1:5432/ez_development
# Required: independently generated random values, each at least32characters and different.
SESSION_SECRET=
CONSOLE_SESSION_SECRET=
CLIENT_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173
TENANT_DB_MAX_CLIENTS=32
TENANT_DB_POOL_SIZE=2
# Optional providers and jobs stay off. No Google account is needed for password login.
AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_MAX_CONCURRENT=2
MAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
WORKER_ENABLED=false
SCHEDULER_TIMEZONE=UTC
# Google/Drive/Sheets routes are disabled in this candidate; keys alone do not enable them.
# Backups need independent secure key storage and persistent private output.
BACKUP_KEY=
BACKUP_DIR=/workspace/.ez-backups
BACKUP_UPLOAD_ENABLED=false
BACKUP_PRIVATE_BUCKET_CONFIRMED=false
BACKUP_S3_URI=
