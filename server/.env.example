# Backend reference; node scripts/setup-local-env.mjs creates a private local server/.env.
# Optional providers are unnecessary for company-code/email/password login.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://ez_local:replace_with_local_db_password@127.0.0.1:5432/ez_development
# Supply distinct, random, >=32-character secrets securely. These blanks intentionally fail validation.
SESSION_SECRET=
CONSOLE_SESSION_SECRET=
CLIENT_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173
TENANT_DB_MAX_CLIENTS=32
TENANT_DB_POOL_SIZE=2
# Production uploads stay unavailable until an actual persistent mount is verified.
# Set UPLOAD_DIR to its absolute private directory, then confirm durability explicitly.
STORAGE_PERSISTENCE_CONFIRMED=false
AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_MAX_CONCURRENT=2
MAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
WORKER_ENABLED=false
SCHEDULER_TIMEZONE=UTC
BACKUP_KEY=
BACKUP_DIR=/workspace/.ez-backups
BACKUP_UPLOAD_ENABLED=false
BACKUP_PRIVATE_BUCKET_CONFIRMED=false
BACKUP_S3_URI=
# Google/Drive/Sheets are disabled; do not add keys just to boot the app.
